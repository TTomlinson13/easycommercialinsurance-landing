node_modules/
*.local
*.log
.DS_Store

# Intermediate SSR bundle — consumed by scripts/prerender.mjs, never deployed.
dist-ssr/

# NOTE: dist/ is deliberately NOT ignored. .hostinger.yaml sets both
# install_command and build_command to "echo 'skip'" and publishes `dist`, so
# Hostinger serves the committed build output verbatim — it never builds this
# project. Ignoring the artifact the host serves is how these sites drift from
# source. Regenerate with `npm run build:local` and commit the result.
